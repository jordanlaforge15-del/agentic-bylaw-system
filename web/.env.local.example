# Clerk authentication (production identity provider).
#
# Leave these commented for `npm run dev` against the dev backend
# (uvicorn advisor.api.dev:app) — Clerk's middleware no-ops when
# the publishable key is absent, the proxy routes fall back to
# forwarding X-Test-User-Id, and the chat sidebar renders the
# static "Halifax Studio" placeholder instead of <UserButton />.
#
# To turn Clerk on, uncomment and set REAL keys from your Clerk
# dashboard → API keys. Placeholder strings (e.g. "pk_test_replace-me")
# WILL crash @clerk/backend at runtime with a "Missing publishableKey"
# error — leave the lines commented until you have real values.
# Never run a public deployment without these set.

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_…
# CLERK_SECRET_KEY=sk_live_…

# Disables Clerk's "keyless mode" auto-instance + the bottom-right
# "claim your keys" popup that appears in dev when no publishable
# key is set. Always-on is safe: when real keys are present (Clerk
# mode), keyless mode never activates anyway, so this flag has no
# effect. Without it, every page render in dev mode would mount a
# Clerk widget pointing at upstream — embarrassing in front of
# trial users.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

# URLs Clerk's middleware uses to redirect unauthenticated users.
# Only relevant when the keys above are set. Match the routes mounted
# at web/app/sign-in and web/app/sign-up.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk webhooks. Set on the ADVISOR (FastAPI) container, NOT here —
# webhooks are processed by the backend so user lifecycle events sync
# directly into advisor_user. This line is a documentation breadcrumb:
# the secret lives in the advisor service's env (.env on the server),
# under CLERK_WEBHOOK_SECRET, paired with the endpoint
#   https://api.<your-domain>/v1/webhooks/clerk
# configured in your Clerk dashboard.

# Operator allowlist for /admin/*. Comma-separated Clerk user ids.
#
# Since ABS-530 removed the shared-password gate, this is the ONLY way
# into the admin surface: proxy.ts reads it at module load and 404s any
# signed-in user who isn't listed. Unset means nobody is an admin —
# fail closed. The advisor service needs the same value for its
# admin API (see docs/DEPLOYMENT.md).
ADVISOR_ADMIN_CLERK_USER_IDS=

# Transactional email — used by /api/admin/invites/[id]/approve to send
# the "you're in" message after admin approval. Recommend Porkbun SMTP
# against the mailbox already hosting info@<your-domain>.
# All five vars must be present or the approve handler silently skips
# the send (logs a warning and returns emailSent=false to the admin
# UI so they can copy the sign-in link out-of-band).
# SMTP_HOST=smtp.porkbun.com
# SMTP_PORT=587
# SMTP_USER=info@agenticbylawsystems.com
# SMTP_PASS=<mailbox-password-or-app-password>
# MAIL_FROM=ABS° <info@agenticbylawsystems.com>
# INVITE_PUBLIC_URL=https://agenticbylawsystems.com

# ABS-507: absolute public origin of the site. Read by web/lib/site-url.ts
# and used to build the absolute URLs in /robots.txt (the `Sitemap:` line)
# and /sitemap.xml (`<loc>` values). Server-only on purpose — a
# NEXT_PUBLIC_ var would be inlined at build time and a runtime value
# could never override it. Trailing slash optional. Defaults to the
# production hostname when unset.
# SITE_URL=https://agenticbylawsystems.com

# Sentry error tracking for the Next.js frontend. NEXT_PUBLIC_SENTRY_DSN
# is inlined into the client bundle at build time — leave unset to disable.
# Server-side code reads the same DSN via instrumentation.ts.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT is optional (defaults to "production").
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=  # optional — git SHA or image tag, set at build time

# ABS-259: General Feedback button gate.
#
# The floating "Feedback" button in the bottom-right of /app overlaps the
# "Send to Team" button and is poor UX in production. Hidden by default.
# Set to "true" to re-enable locally or in e2e. Leave unset in production.
NEXT_PUBLIC_GENERAL_FEEDBACK_ENABLED=true

# Advisor (FastAPI) backend the /api/chat proxy forwards to. Run via:
#   uvicorn advisor.api.dev:app --host 127.0.0.1 --port 8000   (dev)
#   uvicorn advisor.api.main:app --host 0.0.0.0 --port 8000    (prod)
#
# In dev, ADVISOR_DEMO_USER_ID is sent as X-Test-User-Id when
# CLERK_SECRET_KEY is unset — anything stable per-process is fine;
# the backend uses it to key its in-memory session store.
ADVISOR_API_URL=http://127.0.0.1:8000
ADVISOR_DEMO_USER_ID=demo-user-1
