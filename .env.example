DATABASE_URL=postgresql+psycopg://layer1:layer1@localhost:5432/layer1

# Layer 1 parsing
OCR_ENABLED=false
CAMELOT_ENABLED=false
LOG_LEVEL=INFO
BOILERPLATE_REPETITION_THRESHOLD=2

# Layer 2 LLM. Default client is ClaudeCodeLLMClient (routes through `claude -p`,
# billed against the Claude Code subscription). These env vars are only consulted
# when explicitly using OpenAICompatibleLLMClient (requires a code edit in cli.py).
# Set LAYER2_LLM_MODEL=mock-layer2 to use the deterministic MockLLMClient.
OPENAI_API_KEY=
LAYER2_LLM_BASE_URL=https://api.openai.com/v1
LAYER2_LLM_API_KEY=
LAYER2_LLM_MODEL=gpt-5.4

# Layer 2 embeddings. Leave LAYER2_EMBEDDING_BASE_URL unset to use hashing embeddings.
LAYER2_EMBEDDING_BASE_URL=
LAYER2_EMBEDDING_API_KEY=
LAYER2_EMBEDDING_MODEL=hashing-bge-small-en-v1.5
LAYER2_EMBEDDING_DIMENSIONS=384

# Layer 2 retrieval and prompt behavior.
LAYER2_PROMPT_VERSION=v1
LAYER2_RETRIEVAL_VERSION=v1
LAYER2_TOKEN_BUDGET=3000
LAYER2_TOP_K=8
LAYER2_MAX_CACHED_CLAIMS=4

# AUDIT_LLM_MODEL is deprecated — claude -p picks the model internally post-ABS-109.
AUDIT_MAX_BLOCKS_PER_PAGE=40
AUDIT_MAX_FRAGMENTS_PER_PAGE=40

# Google Maps geocoder (civic-address fallback when no in-database
# civic_address dataset is loaded). Leave unset to disable — a WARNING is
# emitted on first attempted use so the silent-skip is diagnosable.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Advisor (Layer 3) — chat API served by `uvicorn advisor.api.main:app`.
# ---------------------------------------------------------------------------

# LLM gateway. ANTHROPIC_API_KEY is required for the production entrypoint.
ADVISOR_LLM_PROVIDER=anthropic
ADVISOR_LLM_MODEL=claude-opus-4-5

# Alternative provider: `claude_code` drives the `claude -p` CLI, billed
# against an operator's Claude Code subscription instead of per token.
# It REQUIRES that ANTHROPIC_API_KEY be absent from the process
# environment — the CLI silently falls back to metered API billing when
# the key is present (anthropics/claude-code#43333), so the advisor
# refuses to start in that combination. Production stays on `anthropic`.
# ADVISOR_LLM_PROVIDER=claude_code
#
# Path to the `claude` binary. Unset means "resolve `claude` on PATH".
# ADVISOR_CLAUDE_CODE_CLI_PATH=
# Per-subprocess wall-clock budget in seconds (default 300).
# ADVISOR_CLAUDE_CODE_TIMEOUT_S=300
# Total attempts per turn, not retries-after-the-first (default 3).
# Worst-case turn latency is TIMEOUT_S * MAX_RETRIES.
# ADVISOR_CLAUDE_CODE_MAX_RETRIES=3

# Clerk auth. Leave CLERK_JWKS_URL unset for local dev — the chat API will
# accept an X-Test-User-Id header instead and log a WARNING at startup.
# Production deployments MUST set all three.
#
# CLERK_JWKS_URL is the "JWKS endpoint" shown on your Clerk dashboard's
# API Keys page (https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# for dev, https://clerk.<your-domain>/.well-known/jwks.json for prod).
# CLERK_AUDIENCE is the JWT template "audience" you configured (we use
# the default template; aud is your Clerk Frontend API URL).
# CLERK_ISSUER is the JWT issuer URL — same Frontend API host as JWKS,
# without the .well-known suffix.
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_ISSUER=

# Clerk webhooks. The "Signing Secret" from your Clerk dashboard's
# Webhooks page (starts with whsec_...). Required to verify the
# svix signature on POST /v1/webhooks/clerk; without it, the webhook
# route is unmounted and user lifecycle events (user.created /
# user.updated / user.deleted) are NOT synced into advisor_user.
# Configure the endpoint in Clerk dashboard as:
#   https://api.<your-domain>/v1/webhooks/clerk
# subscribing to user.created, user.updated, user.deleted.
CLERK_WEBHOOK_SECRET=

# Submission artefact storage (ABS-87). Where POST /v1/submissions and
# POST /v1/integrations/submissions stage the uploaded IFC / PDF before the
# extractors read it (files land in <dir>/user-<id>/<filename>). The default
# below is fine for local dev, where the working tree is writable.
#
# PRODUCTION: the advisor container is `read_only: true`, so this MUST point
# at a writable volume mount or every upload returns
# 503 submission_storage_unavailable. docker-compose.production.yml mounts
# the `bylaw_submissions` named volume at /var/lib/bylaw/submissions and sets
# this accordingly. `GET /healthz` reports `checks.submission_storage` —
# "ok" means the path is writable, "unwritable" means the volume is missing.
SUBMISSION_STORAGE_DIR=data/submissions

# ---------------------------------------------------------------------------
# Beta pivot billing matrix (ABS-379 epic) — turn-based token wallet + gated
# written reports. The chat product ("Conversation") is billed per turn out
# of a prepaid token wallet; written reports ("Answers") are sold per-slug.
# ---------------------------------------------------------------------------

# Master switch. When false the /v1/billing/* endpoints return 503 and no
# Stripe code path runs (dormant mode). The beta go-live posture is TRUE:
# the wallet, the turn-burn on chat, and the report menu are all live.
ADVISOR_BILLING_ENABLED=true

# Payments posture (set per environment). With billing enabled but
# ADVISOR_PAYMENTS_ENABLED=false (the trial-only go-live posture), the wallet
# is funded ONLY by the signup grant and paid top-ups are refused
# (POST /v1/billing/checkout/topup → 503 payments_disabled) — NO Stripe, no
# bank account, no Price IDs needed. Flip to true and configure the
# STRIPE_PRICE_TOPUP_* IDs to light up the Stripe top-up path with no code
# change.
ADVISOR_PAYMENTS_ENABLED=false

# Conversation-product entry switch (ABS-324). The beta pivot leads with the
# turn-based /app chat, so this is TRUE: /cases/new surfaces the conversation
# entry (anchor + question + start-conversation CTA). Flip false to fall back
# to an Answers-only entry.
ADVISOR_CONVERSATION_ENTRY_ENABLED=true

# Per-report gate (ABS-384). Comma-separated report slugs enabled for
# purchase, or `*` for all. Unset/empty = NONE (deny-by-default): the report
# menu is empty and /cases/new reads as a pure conversation page. Read at
# request time — a slug can be enabled/disabled with a config flip, no
# redeploy. RUNBOOK: disable a slug only AFTER draining any `authorized`
# (uncaptured-hold) purchases of it — see docs/RUNBOOK for the drain steps.
# Valid slugs: permitted_use, development_standards, due_diligence,
# legal_nonconforming, variance_justification.
ADVISOR_ENABLED_QUESTIONS=permitted_use,development_standards,due_diligence,legal_nonconforming,variance_justification

# Off-menu "Other" free-form question kill switch (ABS-325). Too open-ended
# to expose at launch; default off (the /questions/quote + /checkout/other
# endpoints return 503). The engine stays wired — re-enabling is a flag flip.
ADVISOR_OTHER_QUESTION_ENABLED=false

# --- Token wallet / turns parameters (ABS-380). Read fresh from the
# environment at call time, so a re-calibration takes effect with no restart.
# Values below are the ABS-416 calibration against measured prod burn (a real
# grounded question costs 103k-248k tokens); see src/advisor/billing/turns.py
# for the sample and the derivation. The grant and warn threshold were
# resized on ABS-404 against the MEASURED cost per wallet-counted token
# (~$28.9/MTok, docs/COST_MODEL.md) rather than the ~$5.5/MTok anchor
# ABS-416 assumed.
# Tokens attributed to one displayed "turn" (the UI divisor; backend-owned).
ADVISOR_TOKENS_PER_TURN=175000
# Tokens granted once to a brand-new user's wallet on first sign-in (3 turns).
ADVISOR_SIGNUP_TOKEN_GRANT=525000
# Pre-flight floor: a chat turn is refused (402) at balance <= floor.
ADVISOR_CHAT_MIN_BALANCE_TOKENS=0
# Warn threshold: the wallet flips to "low balance" at balance <= warn (1 turn).
ADVISOR_LOW_BALANCE_WARN_TOKENS=175000
# Tool-loop iteration cap per chat turn (ABS-382). Default 20.
ADVISOR_CHAT_MAX_ITERATIONS=20
# Per-turn ceiling on MEASURED wallet tokens (input + output) before the
# tool loop forces synthesis (ABS-404). Unset = 2 x ADVISOR_TOKENS_PER_TURN.
# This is the only breaker denominated in the unit the wallet charges; the
# ABS-291/305 ones estimate input tokens and cannot see an output-heavy or
# tool_result-heavy runaway turn. Do not set it to 0 to "disable" it.
ADVISOR_TURN_MAX_WALLET_TOKENS=350000

# Stripe credentials — required only when ADVISOR_PAYMENTS_ENABLED=true.
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# Token top-up Price IDs (ABS-381) — one per SKU, display amount MUST equal
# the SKU's price_cents (see advisor.billing.topups). Configure these when
# payments are enabled.
# STRIPE_PRICE_TOPUP_SMALL=
# STRIPE_PRICE_TOPUP_MEDIUM=
# STRIPE_PRICE_TOPUP_LARGE=

# RETIRED — legacy case-credit tier/pack Price IDs. The beta pivot replaced
# the 12-SKU tier×pack credit catalog (quick/standard/complex × payg/starter/
# pro/enterprise) with the token wallet above. The STRIPE_PRICE_<TIER>_<PACK>
# env vars and POST /v1/billing/checkout/pack are retired: the endpoint now
# returns 410 packs_retired. Do NOT configure these; they sell nothing.
#   STRIPE_PRICE_QUICK_PAYG / _STARTER / _PRO / _ENTERPRISE
#   STRIPE_PRICE_STANDARD_PAYG / _STARTER / _PRO / _ENTERPRISE
#   STRIPE_PRICE_COMPLEX_PAYG / _STARTER / _PRO / _ENTERPRISE

ADVISOR_BILLING_SUCCESS_URL=http://localhost:3000/billing/success
ADVISOR_BILLING_CANCEL_URL=http://localhost:3000/billing/cancel

# Sentry error tracking. Leave SENTRY_DSN unset to disable. When set,
# the SDK initialises at startup and captures unhandled exceptions +
# performance traces. SENTRY_ENVIRONMENT defaults to "production";
# override for staging/dev. SENTRY_TRACES_SAMPLE_RATE (0.0–1.0) controls
# the fraction of requests that generate performance traces (default 0.1).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=  # optional — set to the git SHA or image tag at build time
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Availability monitoring (ABS-122) — runs as a separate container.
# The monitor polls MONITOR_TARGET_URL every MONITOR_PROBE_INTERVAL_SECONDS
# seconds and dispatches alerts after MONITOR_FAILURE_THRESHOLD consecutive
# failures.  At least one alerting channel must be configured for alerts to
# fire; both Slack and SMTP email are supported simultaneously.
# ---------------------------------------------------------------------------

# URL the monitor polls (defaults to the advisor container's /healthz).
MONITOR_TARGET_URL=http://advisor:8000/healthz
MONITOR_PROBE_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=2

# Slack incoming-webhook URL.  Create one at
# https://api.slack.com/messaging/webhooks and paste the URL here.
# Leave blank to disable Slack alerts.
MONITOR_SLACK_WEBHOOK_URL=

# SMTP email alerts.  All four values must be set to enable email.
MONITOR_ALERT_EMAIL_TO=
MONITOR_SMTP_HOST=
MONITOR_SMTP_PORT=587
MONITOR_SMTP_USER=
MONITOR_SMTP_PASSWORD=
MONITOR_SMTP_FROM=monitor@agenticbylawsystems.com

# uvicorn host/port for `python -m advisor.api.main`.
ADVISOR_HOST=0.0.0.0
ADVISOR_PORT=8000
