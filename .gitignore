.env
.venv
.venv/
backups/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
dist/
build/

# Secret material — keep out of version control.
google_maps_api_key
openai_apikey
*_api_key
*_apikey
*.pem
*.key

# Local cache for URL-fetched datasets. Keep schema configs and small
# fixtures under data/geo-datasets/ tracked, but evict the per-fetch
# artifacts that the URL-based ingester writes.
data/.cache/

# Clone-DB env files written by scripts/clone-dev-db.sh.
.env.clone.*

# Local scratch — never committed
tmp/
.claude/*
# …except shared config and skills, which ship with the repo.
!.claude/settings.json
!.claude/skills/
.DS_Store
*.swp

# E2E test stack runtime state (PIDs, logs) — see scripts/e2e-up.sh.
.e2e/

# Night Manager runtime state (logs, state, reports)
.night-manager/

# Typo guard: a stray .claire/ directory appeared in the past (vs .claude/).
.claire/

# Layer1 audit + pipeline runtime outputs (separate from .night-manager/).
logs/
abs-learning/output/

# Per-user submission storage written by the advisor app at runtime.
data/submissions/

# Regenerated on every e2e run by scripts/seed_e2e_submission_ifc.py;
# tracking it would dirty the worktree every `make e2e` and trip the
# Night Manager merge precondition (see ABS-157).
web/e2e/fixtures/submission-demo.ifc
